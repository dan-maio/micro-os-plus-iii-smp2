# This repository holds only the alignment documents and check results.
# The five code repositories next to it have their own git repositories.
/*
!/.gitignore
!/WHY-SMP-BUILD-TEST-DIFFERS.*
!/baseline-2026-11-17/
!/step1-check/
!/step2-check/
!/step3-check/
!/step4-check/
# The step 4 snapshots (every compile and build command before and after) are
# large and carry the user's cache-only settings (Wi-Fi test credentials):
# local only. compare.py and compare-all.txt are the record.
/step4-check/before/
/step4-check/*.ninja-cmds.after
!/step5-check/
/step5-check/before/
/step5-check/*.ninja-cmds.after
/step5-check/before-move/
/step5-check/*.ninja-cmds.after-move
/step5-check/5b/elf-*/
/step5-check/5b/keep/
!/step6-check/
/step6-check/before/
/step6-check/before-rename/
/step6-check/*.ninja-cmds.after
/step6-check/*.ninja-cmds.after-rename
/step6-check/before-rename2/
/step6-check/*.ninja-cmds.after-rename2
!/step5c-check/
/step5c-check/before/
/step5c-check/after/
/step5c-check/after2/
/step5c-check/after3a/
/step5c-check/after3b/
/step6-check/after6b8/
/step6-check/after6b9a/
